# Copy to .env.local. Every value is optional: the demo runs without any of them.

# Ask Hygieia uses OpenAI. Set the key in .env.local or your deployment secret store.
OPENAI_API_KEY=
# Model and reasoning settings for Ask Hygieia.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

# Only for the api.nasa.gov fallback in `npm run fetch-data` (the default DONKI endpoint needs no key).
NASA_API_KEY=

# Not used: Earth mode reads NASA POWER instead, which needs no account.
METEOMATICS_USER=
METEOMATICS_PASSWORD=

# Optional overrides.
# HYGIEIA_DB=./hygieia.db
# HYGIEIA_DAY=143
# HYGIEIA_PROFILE=transit
# HYGIEIA_SEED=2026
